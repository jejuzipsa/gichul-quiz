{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automotive Technician Quiz Item",
  "type": "object",
  "required": [
    "id",
    "round",
    "subject_number",
    "question_number",
    "question",
    "choices",
    "answer",
    "explanation",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^auto-r[0-9]{2}-s[0-9]{2}-q[0-9]{2}$"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "subject_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "question_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "question": {
      "type": "string"
    },
    "choices": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string"
      }
    },
    "answer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "answer_verified": {
      "type": "boolean"
    },
    "explanation": {
      "type": "string"
    },
    "review_status": {
      "enum": [
        "needs_review",
        "approved",
        "rejected"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object"
    }
  }
}
